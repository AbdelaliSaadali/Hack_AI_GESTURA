<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Gestura"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gestura">

        <!-- Attribution and ownership metadata -->
        <meta-data
            android:name="com.gestura.app.AUTHOR"
            android:value="Abdelali Saadali" />
        <meta-data
            android:name="com.gestura.app.COPYRIGHT"
            android:value="© 2026 Abdelali Saadali. All rights reserved." />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Gestura.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
